.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Editor settings
.vscode/
.idea/

# Pokemon Showdown server (cloned separately by scripts/setup_showdown.ps1, ~200MB)
pokemon-showdown/

# Experiment outputs: weights, checkpoints and logs are regenerated by training
results/**/checkpoints/
results/**/tensorboard/
results/**/*.zip
results/**/*.pkl
results/_logs/
results/_snapshot/
